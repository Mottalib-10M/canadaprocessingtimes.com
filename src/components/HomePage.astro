---
/**
 * Accueil : le simulateur de délai, les repères, la réponse repliée, la phrase de valeur ajoutée, les normes de
 * service d'IRCC, les volumes des données ouvertes, les plus forts écarts par pays, les familles de pages, les textes
 * longs en accordéons, la FAQ. Texte : src/content/home.ts ; chiffres : données ouvertes OGL-Canada 2.0 (trousse K).
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const fr = lang === 'fr';
const pageLink = (id: string, text: string) => (hasRoute(id, lang) ? `<a href="${route(id, lang)}">${text}</a>` : GUIDES.some((g) => g.id === id) ? `<a href="${route(id, 'en')}" hreflang="en">${text}</a>` : text);

/* Normes de service : une ligne par norme distincte (les parrainages hors Canada partagent la même). */
const FAMILY = { en: 'Family class from abroad (spouses, partners, children)', fr: 'Regroupement familial depuis l’étranger (conjoints, partenaires, enfants)' };
const seen = new Set<string>();
const stdRows = K.PROGS.flatMap((g) => {
  const s = K.stdOf(g.id); if (!s) return [];
  const key = JSON.stringify(s.cur); if (seen.has(key)) return []; seen.add(key);
  const name = g.id === 'spousal-out-roc' ? FAMILY[lang] : g.name[lang];
  return [[pageLink(K.PAGE_OF[g.id], name), K.fmtStd(s.cur, lang), `${h.pct(s.cur.perf)} (${h.n(s.cur.total)})`, h.pct(s.prev?.perf)]];
});
const fyCur = K.fmtFy(K.STD_FY, lang), fyPrev = K.fmtFy(K.STD_YEARS[K.STD_YEARS.length - 2], lang);

/* Volumes des douze derniers mois. */
const vol = (label: string, y: { last: number | null; prev: number | null; change: number | null }) => [label, h.n(y.last), h.n(y.prev), h.ch(y.change)];
const volRows = [
  ...(['trIn', 'trFin', 'trOk', 'v1', 'spFin', 'prIn', 'copr', 'cit'] as const).map((m) => vol(K.METRIC[m][lang], K.ops12(m))),
  vol(fr ? 'Résidents permanents admis' : 'Permanent residents admitted', K.pr12('all')),
];

/* Visas de visiteur approuvés : plus forts écarts sur un an parmi les grands pays soumis au visa. */
const moves = K.MAJOR.map((c) => ({ c, y: K.ops12('v1', c) }))
  .filter((m) => (m.y.prev ?? 0) >= 1000 && m.y.change != null)
  .sort((a, b) => Math.abs(b.y.change!) - Math.abs(a.y.change!)).slice(0, 8)
  .map((m) => [K.COUNTRY_PAGE[m.c] ? pageLink(K.COUNTRY_PAGE[m.c], h.cn(m.c)) : h.cn(m.c), h.n(m.y.prev), h.n(m.y.last), h.ch(m.y.change), h.pct(K.approval12(m.c).rate)]);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p class="mt-1 text-sm text-navy-600"><a href={route('method', lang)} class="underline">{fr ? 'Méthode et limites' : 'Method and limits'}</a> · <a href={route('about', lang)} class="underline">{fr ? 'Qui publie ce site' : 'Who publishes this site'}</a></p>
  </header>
  <div data-outil data-chrome><Tool kind="delai" lang={lang} arg={{ g: 'visitor', c: fr ? 'MA' : 'IN' }} idPrefix="home" /></div>
  <dl data-chrome class="limits my-6 text-sm">
    {x.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
  </dl>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <p class="my-6 border-l-4 border-accent-500 pl-4 text-navy-800"><strong>{x.valeur}</strong></p>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Les normes de service d’IRCC et leurs résultats' : 'IRCC’s service standards and their results'}</h2>
    <p class="mt-2 text-navy-700">{x.tableIntro}</p>
    <div data-chrome><Fragment set:html={h.table([fr ? 'Type de demande' : 'Application type', fr ? 'Norme (80 % des demandes)' : 'Standard (80% of applications)', fr ? `Tenue en ${fyCur} (demandes)` : `Met in ${fyCur} (applications)`, fr ? `Tenue en ${fyPrev}` : `Met in ${fyPrev}`], stdRows, fr ? 'Source : Inventaire des services du gouvernement du Canada, normes de service et résultats d’IRCC, données ouvertes (Licence du gouvernement ouvert du Canada).' : 'Source: Government of Canada service inventory, IRCC service standards and results, open data (Open Government Licence of Canada).', ['l', 'r', 'r', 'r'])} /></div>
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Les volumes d’IRCC sur douze mois' : 'IRCC volumes over twelve months'}</h2>
    <p class="mt-2 text-navy-700">{x.volIntro}</p>
    <div data-chrome><Fragment set:html={h.table([fr ? 'Indicateur' : 'Measure', fr ? '12 derniers mois' : 'Last 12 months', fr ? '12 mois d’avant' : 'Previous 12 months', fr ? 'Écart' : 'Change'], volRows, fr ? 'Source : IRCC, Traitement opérationnel et Résidents permanents, données ouvertes (Licence du gouvernement ouvert du Canada) ; chiffres arrondis à 5.' : 'Source: IRCC, Operational Processing and Permanent Residents, open data (Open Government Licence of Canada); figures rounded to 5.', ['l', 'r', 'r', 'r'])} /></div>
  </section>
  {moves.length > 0 && <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Visas de visiteur : les plus forts écarts sur un an' : 'Visitor visas: the largest changes over a year'}</h2>
    <p class="mt-2 text-navy-700">{x.movesIntro}</p>
    <div data-chrome><Fragment set:html={h.table([fr ? 'Pays de citoyenneté' : 'Country of citizenship', fr ? '12 mois d’avant' : 'Previous 12 months', fr ? '12 derniers mois' : 'Last 12 months', fr ? 'Écart' : 'Change', fr ? 'Taux d’approbation, résidence temporaire' : 'Temporary residence approval rate'], moves, undefined, ['l', 'r', 'r', 'r', 'r'])} /></div>
  </section>}
  <section class="mt-10"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10" data-chrome>
    {GROUPS.map((g) => {
      const list = GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h2 class="text-xl font-bold text-navy-900">{g.label[lang]}</h2>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p[lang]!.nav}</a><span class="block text-navy-600">{p[lang]!.card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
</PageLayout>
