---
/**
 * Accueil : le simulateur de délai, les repères de la semaine, la réponse repliée, la phrase de valeur ajoutée,
 * le tableau de tous les types de demande, ce qui a bougé depuis le dernier relevé, les familles de pages,
 * les textes longs en accordéons, la FAQ. Texte : src/content/home.ts ; chiffres : fichiers IRCC relus.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const fr = lang === 'fr';
const pageLink = (id: string, text: string) => (hasRoute(id, lang) ? `<a href="${route(id, lang)}">${text}</a>` : GUIDES.some((g) => g.id === id) ? `<a href="${route(id, 'en')}" hreflang="en">${text}</a>` : text);
const unit = (t: unknown) => (t && typeof t === 'object' && 'u' in (t as object) ? (t as { u: string }).u : 'd');
const rows = K.PROGS.map((g) => {
  const name = pageLink(K.PAGE_OF[g.id], g.name[lang]);
  if (g.src === 'country' && !g.fixed) {
    const r = K.rangeOf(g.id);
    return [name, r ? (fr ? `${h.t(r.lo[1])} à ${h.t(r.hi[1])}` : `${h.t(r.lo[1])} to ${h.t(r.hi[1])}`) : h.t(null), fr ? `selon le pays (${r?.n ?? 0})` : `by country (${r?.n ?? 0})`, h.day(K.L.dates.country)];
  }
  const r = K.readingOf(g.id), tr = K.recentTrend(r.series);
  return [name, h.t(r.t), tr?.delta != null ? K.fmtDelta(tr.delta, unit(r.t), lang) : '', h.day(r.date)];
});
const moves = K.biggestMoves(8).map((m) => [pageLink(K.PAGE_OF[m.prog!.id], m.prog!.name[lang]) + (m.country ? ` · ${h.cn(m.country)}` : ''), K.fmtDays(m.prev, unit(K.readingOf(m.prog!.id, m.country).t), lang), K.fmtDays(m.last, unit(K.readingOf(m.prog!.id, m.country).t), lang), K.fmtDelta(m.delta, unit(K.readingOf(m.prog!.id, m.country).t), lang)]);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p class="mt-1 text-sm text-navy-600"><a href={route('method', lang)} class="underline">{fr ? 'Méthode et limites' : 'Method and limits'}</a> · <a href={route('about', lang)} class="underline">{fr ? 'Qui publie ce site' : 'Who publishes this site'}</a></p>
  </header>
  <div data-outil data-chrome><Tool kind="delai" lang={lang} arg={{ g: 'visitor', c: fr ? 'MA' : 'IN' }} idPrefix="home" /></div>
  <dl data-chrome class="limits my-6 text-sm">
    {x.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
  </dl>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <p class="my-6 border-l-4 border-accent-500 pl-4 text-navy-800"><strong>{x.valeur}</strong></p>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Tous les délais publiés, type par type' : 'Every published time, application by application'}</h2>
    <p class="mt-2 text-navy-700">{x.tableIntro}</p>
    <div data-chrome><Fragment set:html={h.table([fr ? 'Type de demande' : 'Application type', fr ? 'Délai publié' : 'Published time', fr ? 'Écart avec le relevé précédent' : 'Change since previous reading', fr ? 'Date IRCC' : 'IRCC date'], rows, fr ? 'Délais publiés par IRCC, relus sur ses fichiers. Pour les demandes faites hors du Canada, le délai dépend du pays : le tableau donne le plus court et le plus long.' : 'Times published by IRCC, read from its files. For applications made from outside Canada the time depends on the country: the table gives the shortest and the longest.', ['l', 'r', 'r', 'l'])} /></div>
  </section>
  {moves.length > 0 && <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{fr ? 'Ce qui a le plus bougé au dernier relevé' : 'What moved most at the latest reading'}</h2>
    <p class="mt-2 text-navy-700">{x.movesIntro}</p>
    <div data-chrome><Fragment set:html={h.table([fr ? 'Demande' : 'Application', fr ? 'Avant' : 'Before', fr ? 'Maintenant' : 'Now', fr ? 'Écart' : 'Change'], moves, undefined, ['l', 'r', 'r', 'r'])} /></div>
  </section>}
  <section class="mt-10"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10" data-chrome>
    {GROUPS.map((g) => {
      const list = GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h2 class="text-xl font-bold text-navy-900">{g.label[lang]}</h2>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p[lang]!.nav}</a><span class="block text-navy-600">{p[lang]!.card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
</PageLayout>
