---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { KIT as K } from '../../lib/kit';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Publisher and Sources of Canada Processing Times, 2026';
const description = 'Canada Processing Times is published by Radif Partners: IRCC open data and service standards in 2026, a decision date from the time you copy, no account.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About Canada Processing Times</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why this site exists</h2>
    <p>IRCC’s own tool gives one processing time for one application at a time and says nothing about how many files IRCC receives and decides, or how often it meets its own service standards. Many pages that repeat those times sit next to a form that asks for your email or offers a paid assessment. None of them turns the time into a date for your own application.</p>
    <p><strong>This site turns the time IRCC shows into an estimated decision date for your filing date, and puts it next to IRCC’s service standards and the volumes IRCC publishes as open data, with no account and no email.</strong></p>
    <h2>Who publishes it</h2>
    <p>The site is published by {AUTHOR_NAME}, a company that builds calculators from public data. It is not a government body, not IRCC, not a licensed immigration consultant and not a law firm. It sells nothing, takes no commission, refers no one to a representative and asks for no name, email or phone number. Pages carry no affiliate links.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the figures come from</h2>
    <p>From data sets published on the Government of Canada open data portal under the <Fragment set:html={s('ogl', 'Open Government Licence of Canada')} />: IRCC’s <Fragment set:html={s('open-data', 'monthly operational processing updates')} />, <Fragment set:html={s('od-pr', 'permanent residents')} />, <Fragment set:html={s('od-work', 'work permit holders')} />, <Fragment set:html={s('od-study', 'study permit holders')} />, <Fragment set:html={s('od-ee', 'Express Entry invited candidates')} /> and the <Fragment set:html={s('od-std', 'service inventory')} /> with IRCC’s service standards, read on {K.en.day(K.READ)}. Current processing times stay on IRCC’s <Fragment set:html={s('ptimes', 'Check processing times')} /> tool: you copy the time you read there. The <a href={route('method', lang)}>method page</a> gives every rule; the <a href={route('editorial', lang)}>editorial policy</a> explains how corrections are made.</p>
    <h2>What the site does not do</h2>
    <p>It never sees an application, cannot check a status and cannot speed anything up. Its dates are estimates built from IRCC’s published figures: information, not legal advice and not a promise. For your own file, IRCC’s <Fragment set:html={s('check-status', 'status tools')} /> are the reference.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, to report an error or a figure that differs from IRCC’s.</p>
  </article>
</PageLayout>
