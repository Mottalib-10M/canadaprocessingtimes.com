---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'fr';
const path = route('contact', lang);
const description = 'Écrire à l’éditeur de Délais de traitement Canada au sujet d’un chiffre 2026, d’une date ou d’une source. Courriel seulement : sans formulaire, sans compte, sans rien à vendre.';
---
<PageLayout title="Contact Délais de traitement Canada 2026 : corrections" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contact</h1>
    <p>Écrivez à <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Pas de formulaire, pas de téléphone, pas de compte : une adresse, lue par les personnes qui tiennent les données et les calculateurs à jour.</p>
    <h2>Les messages utiles</h2>
    <ul>
      <li>Un chiffre qui diffère des données ouvertes d’IRCC ou une date que le calculateur calcule mal : indiquez la page, le type de demande et les valeurs saisies.</li>
      <li>Un jeu de données ouvertes d’IRCC que le site n’utilise pas encore.</li>
      <li>Intégrer le calculateur sur un site associatif ou étudiant : le code est sur la <a href={route('widget', lang)}>page d’intégration</a>.</li>
    </ul>
    <h2>Ce que nous ne pouvons pas faire</h2>
    <p>Nous ne pouvons ni voir, ni vérifier, ni accélérer une demande, et nous ne donnons pas d’avis juridique. Pour votre dossier, passez par votre compte IRCC ou le formulaire Web d’IRCC. Nous n’orientons personne vers un consultant ou un avocat.</p>
    <h2>Éditeur</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
